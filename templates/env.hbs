{{#if isExample}}
# These are placeholder values, not real secrets.
# Replace them with your own before deploying anywhere shared or production.
# Do not reuse the values from your local .env file.
{{/if}}

# Server
HOST=0.0.0.0
PORT={{port}}

# Secrets
APP_KEYS={{appKeys}}
API_TOKEN_SALT={{apiTokenSalt}}
ADMIN_JWT_SECRET={{adminJwtSecret}}
JWT_SECRET={{jwtSecret}}
TRANSFER_TOKEN_SALT={{transferTokenSalt}}
ENCRYPTION_KEY={{encryptionKey}}

# Database
DATABASE_CLIENT={{dbEngine}}
{{#if (eq dbEngine "sqlite")}}
DATABASE_FILENAME=.tmp/data.db
{{else}}
DATABASE_HOST={{dbHost}}
DATABASE_PORT={{dbPort}}
DATABASE_NAME={{dbName}}
DATABASE_USERNAME={{dbUser}}
DATABASE_PASSWORD={{dbPassword}}
DATABASE_SSL=false
{{/if}}
